!/backend/
!/frontend/

# Credenciales, datos locales y salidas de herramientas.
.env
.env.*
!.env.example
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/*.sqlite3
**/node_modules/
**/dist/
frontend/public/exploracion-color.html
backend/.models/
!/.env.prod.example
