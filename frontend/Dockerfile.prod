# Compila el frontend (Vite) y lo sirve con Caddy, que además hace de proxy
# al backend. Así todo queda en un solo dominio: localizat.duckdns.org.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
