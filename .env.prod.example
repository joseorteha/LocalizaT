# Plantilla del .env de PRODUCCIÓN (para el servidor Oracle).
# Copia este archivo como .env.prod y rellena los valores reales.
# El .env.prod real NUNCA se sube a Git.

# Dominio público del backend (lo creas gratis en DuckDNS).
DOMAIN=localizat-sierra.duckdns.org

# Base de datos Neon. Cópiala de la consola de Neon (con tu contraseña nueva).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clave secreta de Django NUEVA. Genérala con:  openssl rand -hex 32
DJANGO_SECRET_KEY=pon-aqui-una-clave-nueva-larga

# Producción: depuración apagada.
DJANGO_DEBUG=0

# El backend recibe peticiones con este Host (tu dominio DuckDNS).
DJANGO_ALLOWED_HOSTS=localizat-sierra.duckdns.org

# Orígenes de confianza para el login/CSRF: tu dominio de Vercel y el del backend.
DJANGO_CSRF_TRUSTED_ORIGINS=https://TU-APP.vercel.app,https://localizat-sierra.duckdns.org

# Notificaciones push (opcional). Genera un par NUEVO de claves VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
