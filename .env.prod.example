# Plantilla del .env de PRODUCCIÓN (servidor Contabo).
# Copia este archivo como .env.prod y rellena los valores reales.
# El .env.prod real NUNCA se sube a Git.

# Dominio público del backend (lo creas gratis en DuckDNS).
DOMAIN=localizat.duckdns.org

# Base de datos Neon. Cópiala de la consola de Neon (con tu contraseña nueva).
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Clave secreta de Django NUEVA. Genérala con:  openssl rand -hex 32
DJANGO_SECRET_KEY=pon-aqui-una-clave-nueva-larga

# Producción: depuración apagada.
DJANGO_DEBUG=0

# El backend recibe peticiones con este Host (tu dominio DuckDNS).
DJANGO_ALLOWED_HOSTS=localizat.duckdns.org

# Orígenes de confianza para el login/CSRF (el mismo dominio del sitio).
DJANGO_CSRF_TRUSTED_ORIGINS=https://localizat.duckdns.org

# Inicio de sesión con Google. El ID de cliente de LocalizaT ya viene por
# defecto en el código (es público, no es secreto). Solo pon algo aquí si usas
# OTRO proyecto de Google; si no, deja esta línea vacía o bórrala.
GOOGLE_OAUTH_CLIENT_ID=

# Notificaciones push (opcional). Genera un par NUEVO de claves VAPID.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Dirección pública del sitio para los enlaces de los correos. Si la dejas
# vacía se usa https://DOMAIN.
SITE_URL=

# Correo saliente: avisos de coincidencias, recuperar contraseña y verificar
# correo. Sin EMAIL_HOST no sale ningún correo (solo se escriben en el registro).
# Ejemplo con Brevo (gratis, 300 correos al día): crea la cuenta, verifica tu
# remitente y copia la clave SMTP de «SMTP y API».
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# El remitente debe estar verificado en tu proveedor de correo.
DEFAULT_FROM_EMAIL=LocalizaT <tu-correo-verificado@ejemplo.com>

# Monitoreo de errores (opcional): crea un proyecto Django gratis en sentry.io
# y pega aquí su DSN. Vacío = desactivado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
