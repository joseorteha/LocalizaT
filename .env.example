POSTGRES_DB=localizat
POSTGRES_USER=localizat
POSTGRES_PASSWORD=replace-with-a-local-development-password
DJANGO_SECRET_KEY=replace-with-a-long-random-local-development-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Sin claves, la bandeja interna funciona y el botón push queda deshabilitado.
# En despliegue, usa un par VAPID propio; la clave privada PEM va en una línea con saltos como \n.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=https://your-domain.example
