# Caddy saca y renueva solo el certificado HTTPS (Let's Encrypt) para el
# dominio de DOMAIN (.env.prod). Sirve el frontend compilado y reenvía la API,
# el panel /admin y sus estáticos a Django. Todo en un mismo dominio, por eso
# las cookies de sesión funcionan sin complicaciones.
{$DOMAIN} {
	encode gzip zstd

	# Encabezados de seguridad para todo el sitio.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), payment=()"
		-Server
	}

	# Fotos de hasta 8 MB más el resto del formulario.
	request_body {
		max_size 12MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /admin/* {
		reverse_proxy api:8000
	}
	handle /static/* {
		reverse_proxy api:8000
	}

	# El resto es el frontend (app de React). try_files permite recargar en
	# rutas como /explorar sin que dé 404.
	handle {
		root * /srv
		# Los archivos con huella (assets/) se guardan un año. Todo lo demás
		# (index.html, rutas de la app, service worker) se revalida siempre,
		# para que la gente reciba la versión nueva en cuanto se publica.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
